# audio-feedback sound development
# Run from this directory (plugins/audio-feedback). `just` lists recipes.

proj   := "sound-theme/default"
src    := proj / "src"
sounds := proj / "sounds"
py     := proj / ".venv/bin/python"

# list recipes
default:
    @just --list

# sync the dev env from pyproject.toml (uv-managed Python 3.12 + signalflow/numpy/scipy + pytest)
venv:
    cd {{proj}} && UV_PYTHON_PREFERENCE=only-managed uv sync

# render the full palette to sounds/ (always full: loudness is palette-normalized)
generate:
    {{py}} {{src}}/generate.py

# render + play one or more sounds to a temp dir (does NOT touch sounds/)
preview +NAMES:
    {{py}} {{src}}/generate.py preview {{NAMES}}

# watch the src files; re-render + play NAME(s) on every save
live +NAMES:
    {{py}} {{src}}/generate.py live {{NAMES}}

# play the current committed wav (no re-render)
play NAME:
    paplay {{sounds}}/{{NAME}}.wav

# play every committed sound back-to-back
audition:
    #!/usr/bin/env bash
    for w in {{sounds}}/*.wav; do echo "$(basename "$w" .wav)"; paplay "$w"; done

# verify the palette loudness gate (RMS spread <= 5 dB, peak <= -0.7 dBFS)
verify:
    {{py}} scripts/analyze.py --palette {{sounds}}

# run the sound tests (note-map + generator)
test:
    {{py}} -m pytest tests/test_note_map.py tests/test_generate.py -q

# remove preview scratch + pycache
clean:
    rm -rf {{src}}/.preview {{src}}/__pycache__
